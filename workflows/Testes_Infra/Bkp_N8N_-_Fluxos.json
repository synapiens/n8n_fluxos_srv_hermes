        1040
      ],
      "id": "f852241e-3ae3-479b-82a8-6f89bdc352ca",
      "name": "Busca SHA GitHub",
      "credentials": {
        "httpHeaderAuth": {
          "id": "RJY77ZeSs8czzz8z",
          "name": "Github"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const preparaData = $('Prepara Dados').item.json;\nconst shaResponse = $json;\nconst config = $('Configurações').first().json;\n\n// Body pode vir como string — faz parse seguro\nlet sha = null;\nif (shaResponse.statusCode === 200) {\n  try {\n    const body = typeof shaResponse.body === 'string'\n      ? JSON.parse(shaResponse.body)\n      : shaResponse.body;\n    sha = body?.sha || null;\n  } catch (e) {\n    sha = null;\n  }\n}\n\nconst output = {\n  filePath: preparaData.filePath,\n  workflowName: preparaData.workflowName,\n  githubOwner: config.githubOwner,\n  githubRepo: config.githubRepo,\n  message: preparaData.commitMessage,\n  content: preparaData.base64Content,\n  branch: config.githubBranch\n};\n\nif (sha) {\n  output.sha = sha;\n}\n\nreturn [{ json: output }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
