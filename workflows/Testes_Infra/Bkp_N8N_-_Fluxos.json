    {
      "parameters": {
        "jsCode": "const workflow = $json;\nconst content = JSON.stringify(workflow, null, 2);\nconst base64Content = Buffer.from(content).toString('base64');\n\n// Determina a pasta com base na estrutura do N8N\n// Suporta: folders nativas (v1.x+) e tags (versões anteriores)\nlet folderPath = '_sem_pasta';\n\nif (workflow.parentFolder && workflow.parentFolder.name) {\n  folderPath = workflow.parentFolder.name;\n} else if (workflow.folder && workflow.folder.name) {\n  folderPath = workflow.folder.name;\n} else if (workflow.tags && workflow.tags.length > 0) {\n  folderPath = workflow.tags[0].name;\n}\n\n// Sanitiza para uso em caminhos de arquivo\nconst sanitize = (str) => {\n  return String(str)\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '') // remove acentos\n    .replace(/[^a-zA-Z0-9\\-_\\s]/g, '')\n    .trim()\n    .replace(/\\s+/g, '_');\n};\n\nconst sanitizedFolder = sanitize(folderPath);\nconst sanitizedName = sanitize(workflow.name);\nconst filePath = `workflows/${sanitizedFolder}/${sanitizedName}.json`;\n\nreturn [{\n  json: {\n    workflowId: workflow.id,\n    workflowName: workflow.name,\n    filePath,\n    base64Content,\n    commitMessage: `chore: backup \"${workflow.name}\"`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1040
      ],
      "id": "f6a946a2-7bb5-449c-8eb3-67d54beb5eb8",
      "name": "Prepara Dados"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Configurações').first().json.githubOwner }}/{{ $('Configurações').first().json.githubRepo }}/contents/{{ $json.filePath }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
